PROG   = a
CC     = gcc
CFLAGS = -Wall -g
INCS   = -Iglad/include
LIBS   = -lglfw -lGL -ldl -lpthread -lm
OBJS   = OpenGL-GLAM.o glad.o

all: $(PROG)

$(PROG): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)

%.o: %.cpp
	$(CC) $(CFLAGS) $(INCS) -c $< -o $@

%.o: %.c
	$(CC) $(CFLAGS) $(INCS) -c $< -o $@

glad.o: glad/src/glad.c
	$(CC) $(CFLAGS) $(INCS) -c $< -o $@

clean:
	rm -f *~ *.o $(PROG)


